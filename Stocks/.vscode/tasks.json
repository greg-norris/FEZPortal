{
    // The board's tasks, through endpoint-cli (USB). Terminal > Run Task lists them.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "endpoint: stop",
            "detail": "Stop the program running on the board",
            "type": "endpoint",
            "args": ["stop", "app"],
            "problemMatcher": []
        },

        {
            "label": "endpoint: build for debugging",
            "type": "process",
            "command": "dotnet",
            "args": ["publish", "${workspaceFolder}/${workspaceFolderBasename}.csproj", "-c", "Debug", "-r", "linux-arm",
                     "--self-contained", "false", "-o", "${workspaceFolder}/bin/endpoint-debug"],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "endpoint: deploy for debugging",
            "detail": "Used by F5",
            "type": "endpoint",
            "args": ["deploy", "--rid", "linux-arm", "${workspaceFolder}/bin/endpoint-debug",
                     "/data/debug/${workspaceFolderBasename}"],
            "dependsOrder": "sequence",
            "dependsOn": ["endpoint: stop", "endpoint: build for debugging"],
            "problemMatcher": []
        },

        {
            "label": "endpoint: build",
            "detail": "Native AOT release build: one fast-starting program",
            "type": "endpoint",
            "args": ["publish-aot", "${workspaceFolder}/${workspaceFolderBasename}.csproj",
                     "${workspaceFolder}/bin/endpoint-release"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "endpoint: deploy",
            "type": "endpoint",
            "args": ["deploy", "${workspaceFolder}/bin/endpoint-release", "/data/apps/${workspaceFolderBasename}"],
            "dependsOrder": "sequence",
            "dependsOn": ["endpoint: stop", "endpoint: build"],
            "problemMatcher": []
        },
        {
            "label": "endpoint: run",
            "detail": "Run on the board without the debugger and show the output (Ctrl+C stops it)",
            "type": "endpoint",
            "args": ["run", "--tag", "app", "--cwd", "/data/apps/${workspaceFolderBasename}",
                     "/data/apps/${workspaceFolderBasename}/${workspaceFolderBasename}"],
            "dependsOn": "endpoint: deploy",
            "problemMatcher": []
        },
        {
            "label": "endpoint: set run at boot",
            "type": "endpoint",
            "args": ["autostart", "--cwd", "/data/apps/${workspaceFolderBasename}",
                     "/data/apps/${workspaceFolderBasename}/${workspaceFolderBasename}"],
            "problemMatcher": []
        },
        {
            "label": "endpoint: start in background",
            "type": "endpoint",
            "args": ["run", "--detach", "--tag", "app", "--cwd", "/data/apps/${workspaceFolderBasename}",
                     "/data/apps/${workspaceFolderBasename}/${workspaceFolderBasename}"],
            "problemMatcher": []
        },
        {
            "label": "endpoint: run at boot",
            "detail": "Run on the board now and at every boot",
            "dependsOrder": "sequence",
            "dependsOn": ["endpoint: deploy", "endpoint: set run at boot", "endpoint: start in background"],
            "problemMatcher": []
        },
        {
            "label": "endpoint: stop run at boot",
            "detail": "Start nothing at boot",
            "type": "endpoint",
            "args": ["autostart", "--off"],
            "problemMatcher": []
        }
    ]
}
