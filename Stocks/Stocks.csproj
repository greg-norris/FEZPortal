<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Stocks</RootNamespace>
    <!-- EPDomino24 = STM32MP153 (armv7l). The board has the .NET runtime in
         /root/.epnet/dotnet, so the app is framework-dependent. -->
    <RuntimeIdentifier>linux-arm</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Noto Sans, SIL Open Font License (Resources\NotoSans-OFL.txt) -->
    <EmbeddedResource Include="Resources\NotoSans-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wi-Fi network name and password, read at startup (WifiManager.cs) -->
    <None Include="wifi.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Finnhub API key and the watchlist (Settings.cs) -->
    <None Include="stocks.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GHIElectronics.Endpoint.Core" Version="0.5.3-preview" />
    <PackageReference Include="GHIElectronics.Endpoint.Devices.Display" Version="0.5.3-preview" />
    <PackageReference Include="GHIElectronics.Endpoint.Devices.Touch" Version="0.5.3-preview" />
    <PackageReference Include="GHIElectronics.Endpoint.UI" Version="0.5.3-preview" />
  </ItemGroup>

</Project>
